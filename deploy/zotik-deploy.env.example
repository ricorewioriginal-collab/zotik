# /etc/zotik-deploy.env – settings of the ZOTIK deploy (all optional)
#REPO_URL=https://github.com/ricorewioriginal-collab/zotik.git
#BRANCH=main
#TARGETS="windows android"      # add linux and/or web if wanted
#RUN_TESTS=1                    # 1 = deploy only if the regression tests pass (adds about 4 minutes)
#KEEP=3                         # releases kept on the server
#WEB_ROOT=/var/www/zotik
# Cloud-save OAuth client (same as the GitHub secrets), leave empty to skip:
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
