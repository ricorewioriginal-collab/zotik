; ZOTIK – Die Splitter der Welten
; Godot 4 starter project – Build 01 / Lunaris
config_version=5

[application]
config/name="ZOTIK – Die Splitter der Welten"
run/main_scene="res://scenes/worlds/lunaris/Lunaris.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
attack={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1),Object(InputEventKey,"physical_keycode":32)]}
dodge={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70),Object(InputEventKey,"physical_keycode":4194321)]}
block={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":2),Object(InputEventKey,"physical_keycode":4194325)]}
lock_on={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
